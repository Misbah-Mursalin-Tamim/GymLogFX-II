<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.RoutineBuilderController"
            style="-fx-background-color: #F4F5F7;">

    <left>
        <VBox fx:id="sidebar"
              spacing="12"
              prefWidth="200"
              style="-fx-background-color: #EDEFF2;">

            <padding>
                <Insets top="30" right="15" bottom="30" left="15"/>
            </padding>

            <Label text="GymLogFX"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2D6CDF;"/>

            <Button text="Dashboard" maxWidth="Infinity" onAction="#goToDashboard"
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10;"/>

            <Button text="Exercises" maxWidth="Infinity" onAction="#goToExercises"
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10;"/>

            <Button text="Routines" maxWidth="Infinity" onAction="#goToRoutines"
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10;"/>

            <Button text="Log Workout" maxWidth="Infinity" onAction="#goToWorkoutLogger"
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10;"/>

            <Button text="Progress" maxWidth="Infinity" onAction="#goToProgress"
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10;"/>

            <Button text="History" maxWidth="Infinity" onAction="#goToHistory"
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10;"/>

        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    style="-fx-background: transparent; -fx-background-color: transparent;">

            <VBox spacing="25">

                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>

                <Label text="Routine Builder"
                       style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;"/>

                <HBox fx:id="mainRow" spacing="25" maxWidth="Infinity" prefHeight="480">

                    <VBox fx:id="routinesCard" spacing="12" prefWidth="280"
                          style="-fx-background-color: white; -fx-background-radius: 12;">

                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <Label text="Your Routines"
                               style="-fx-font-size: 15; -fx-font-weight: bold;"/>

                        <TableView fx:id="routineTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="routineNameColumn" text="Routine Name"/>
                            </columns>
                        </TableView>

                        <TextField fx:id="routineNameField" promptText="Routine name"
                                   style="-fx-background-radius: 6; -fx-padding: 8;"/>

                        <Label fx:id="statusLabel" wrapText="true"
                               style="-fx-text-fill: #D9534F; -fx-font-size: 12;"
                               visible="false" managed="false"/>

                        <HBox spacing="8">
                            <Button text="New" onAction="#handleNew"
                                    style="-fx-background-color: #EDEFF2; -fx-background-radius: 6; -fx-padding: 8 12;"/>

                            <Button text="Save" onAction="#handleSave"
                                    style="-fx-background-color: #2D6CDF; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 12;"/>

                            <Button text="Delete" onAction="#handleDelete"
                                    style="-fx-background-color: #D9534F; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 12;"/>
                        </HBox>

                    </VBox>

                    <VBox fx:id="exercisesCard" spacing="14" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 12;">

                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <Label text="Select Exercises for this Routine"
                               style="-fx-font-size: 15; -fx-font-weight: bold;"/>

                        <HBox fx:id="pickerRow" spacing="15" VBox.vgrow="ALWAYS">

                            <VBox fx:id="availableBox" spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Available"
                                       style="-fx-text-fill: #8A8A8A; -fx-font-size: 12;"/>
                                <ListView fx:id="availableListView" VBox.vgrow="ALWAYS"/>
                            </VBox>

                            <VBox fx:id="buttonsBox" spacing="10" alignment="CENTER" prefWidth="90">
                                <Button text="Add &gt;&gt;" maxWidth="Infinity" onAction="#handleAddToRoutine"
                                        style="-fx-background-color: #EDEFF2; -fx-background-radius: 6; -fx-padding: 8;"/>
                                <Button text="&lt;&lt; Remove" maxWidth="Infinity" onAction="#handleRemoveFromRoutine"
                                        style="-fx-background-color: #EDEFF2; -fx-background-radius: 6; -fx-padding: 8;"/>
                            </VBox>

                            <VBox fx:id="chosenBox" spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="In this Routine"
                                       style="-fx-text-fill: #8A8A8A; -fx-font-size: 12;"/>
                                <ListView fx:id="chosenListView" VBox.vgrow="ALWAYS"/>
                            </VBox>

                        </HBox>

                    </VBox>

                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>