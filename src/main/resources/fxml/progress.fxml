<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ProgressController"
            style="-fx-background-color: #F4F5F7;">

    <left>
        <VBox fx:id="sidebar"
              spacing="12"
              prefWidth="200"
              style="-fx-background-color: #EDEFF2;">

            <padding>
                <Insets top="30" right="15" bottom="30" left="15"/>
            </padding>

            <Label text="GymLogFX"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2D6CDF;"/>

            <Button text="Dashboard" maxWidth="Infinity" onAction="#goToDashboard"
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10;"/>

            <Button text="Exercises" maxWidth="Infinity" onAction="#goToExercises"
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10;"/>

            <Button text="Routines" maxWidth="Infinity" onAction="#goToRoutines"
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10;"/>

            <Button text="Log Workout" maxWidth="Infinity" onAction="#goToWorkoutLogger"
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10;"/>

            <Button text="Progress" maxWidth="Infinity" onAction="#goToProgress"
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10;"/>

            <Button text="History" maxWidth="Infinity" onAction="#goToHistory"
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10;"/>

        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    style="-fx-background: transparent; -fx-background-color: transparent;">

            <VBox spacing="25">

                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>

                <Label text="Progress"
                       style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #2D2D2D;"/>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Choose Exercise:"
                           style="-fx-font-size: 14;"/>

                    <ComboBox fx:id="exerciseComboBox" prefWidth="250"/>
                </HBox>

                <StackPane fx:id="chartCard" maxWidth="Infinity"
                           style="-fx-background-color: white; -fx-background-radius: 12;">

                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>

                    <VBox spacing="10">
                        <Label text="Weight Over Time"
                               style="-fx-font-size: 16; -fx-font-weight: bold;"/>

                        <LineChart fx:id="progressChart" maxWidth="Infinity" prefHeight="320"
                                   legendVisible="false">
                            <xAxis>
                                <CategoryAxis label="Date"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Weight (kg)"/>
                            </yAxis>
                        </LineChart>
                    </VBox>

                </StackPane>

                <VBox fx:id="resultCard" spacing="8" maxWidth="Infinity"
                      style="-fx-background-color: white; -fx-background-radius: 12;">

                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <Label text="Progressive Overload Check"
                           style="-fx-font-size: 15; -fx-font-weight: bold;"/>

                    <Label fx:id="resultLabel" text="Choose an exercise to see your progress."
                           wrapText="true"
                           style="-fx-font-size: 14; -fx-text-fill: #2D2D2D;"/>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>